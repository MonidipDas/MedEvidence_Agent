# Streamlit Secrets – used by Streamlit Cloud deployment
# ─────────────────────────────────────────────────────
# To deploy on Streamlit Cloud:
#   1. Push this repo to GitHub
#   2. Go to https://share.streamlit.io → New app
#   3. In "Advanced settings → Secrets", paste your secrets in TOML format:
#
#      SARVAM_API_KEY = "sk_7zzgz0xm_TqTNIr5cqMY0cSA1GupaHbk6"
#
# For LOCAL development, rename this file to secrets.toml and fill it in.
# The .gitignore already excludes secrets.toml from version control.

SARVAM_API_KEY = "sk_7zzgz0xm_TqTNIr5cqMY0cSA1GupaHbk6"
